# ==============================================================================
# Namma Yatra (ನಮ್ಮ ಯಾತ್ರೆ) — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - All environment variables defined here are SERVER-SIDE ONLY.
# - NEVER prefix these variables with VITE_ to prevent leaking secrets into client bundles.
# - NEVER commit your real .env file with active keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration [REQUIRED FOR AI GENERATION]
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas Database Configuration [OPTIONAL — STANDBY MODE IF OMITTED]
# ------------------------------------------------------------------------------
# Required for user accounts (registration/login) and cross-device cloud trip sync.
# If omitted, the application runs in local guest mode with browser-only storage.
# Connection URI format:
# mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority"

# Database name in MongoDB Atlas (defaults to YatraAI if omitted)
MONGODB_DB_NAME="YatraAI"

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security [REQUIRED IF MONGODB_URI IS SET]
# ------------------------------------------------------------------------------
# Cryptographically random secret key used to sign HTTP-only session JWT cookies.
# In production, use a strong 32+ character random string (e.g. openssl rand -base64 32).
JWT_SECRET="replace_with_a_long_random_secret_key_in_production"

# ------------------------------------------------------------------------------
# 4. Server Runtime Configuration [OPTIONAL]
# ------------------------------------------------------------------------------
# Server listening port (Render sets this dynamically in production; defaults to 3000)
PORT=3000

# Runtime environment ('development' | 'production')
NODE_ENV="development"

# Base URL of the application
APP_URL="http://localhost:3000"
